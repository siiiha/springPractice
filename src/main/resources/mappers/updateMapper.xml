<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.practice.update.BoardUpdateMapper">

    <update id="updateBoard" parameterType="com.example.practice.update.BoardUpdateDto">
        UPDATE board_table
        <set>
            <if test="title != null">title = #{title},</if>
            <if test="category !=null">category = #{category},</if>
            <if test="content !=null">content = #{content},</if>
        </set>
        WHERE board_id = #{boardId}
          AND deleted_at IS NULL
    </update>

    <select id="getBoardDetail"
            resultType="com.example.practice.update.BoardUpdateDto">
        SELECT board_id AS boardId,
        title,
        category,
        content
        FROM board_table
        WHERE board_id = #{boardId}
          AND deleted_at IS NULL
    </select>

</mapper>
